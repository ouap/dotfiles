[user]
	name = Ouams
	email = 2905652+ouap@users.noreply.github.com
	useConfigOnly = true

[core]
  editor = vim
  autocrlf = input
	excludesfile = ~/.config/git/ignore

[init]
  defaultBranch = main

[pull]
  rebase = true

[rebase]
  autoStash = true

[alias]
  # Status / inspection
  st = status -sb
  lg = log --oneline --graph --decorate
  lga = log --graph --oneline --decorate --all
  last = log -1 HEAD

  # Navigation
  sw = switch
  swc = switch -c
  co = checkout
  br = branch

  # Staging / commit
  a = add
  aa = add .
  cm = commit -m
  amend = commit --amend --no-edit

  # Rebase / sync
  up = pull --rebase
  rb = rebase
  rbi = rebase -i

  # Reset / undo
  unstage = reset HEAD --
  undo = reset --soft HEAD~1

  # Helpers
  wip = commit -am "wip"
